    "sections": [
      {
        "level": 2,
        "heading": {
          "text": "Dialogue",
          "wikitext": "Dialogue"
        },
        "role": {
          "role": "dialogue"
        },
        "blocks": [
          {
            "block": "exchange",
            "turns": [
              {
                "speaker": "Ellie Chu",
                "text": {
                  "text": "\"I never really thought about the oppression of fitting in before. The good thing about being different is that no one expects you to be like them.\"",
                  "wikitext": "'''Ellie Chu''': \"I never really thought about the oppression of fitting in before. The good thing about being different is that no one expects you to be like them.\""
                },
                "is_stage_direction": false
              }
            ]
          },
          {
            "block": "rule"
          },
          {
            "block": "exchange",
            "turns": [
              {
                "speaker": "Ellie Chu",
                "text": {
                  "text": "Aster Flores thinks you're into abstract art and repressed British literature.",
                  "wikitext": "'''Ellie Chu''': Aster Flores thinks you're into abstract art and repressed British literature."
                },
                "is_stage_direction": false
              },
              {
                "speaker": "Paul Munsky",
                "text": {
                  "text": "Yeah.",
                  "wikitext": "'''Paul Munsky''': Yeah."
                },
                "is_stage_direction": false
              },
              {
                "speaker": "Ellie Chu",
                "text": {
                  "text": "None of that is you.",
                  "wikitext": "'''Ellie Chu''': None of that is you."
                },
                "is_stage_direction": false
              },
              {
                "speaker": "Paul Munsky",
                "text": {
                  "text": "It could be. I started reading that Remains Of The Day book.",
                  "wikitext": "'''Paul Munsky''': It could be. I started reading that Remains Of The Day book."
                },
                "is_stage_direction": false
              },
              {
                "speaker": "Ellie Chu",
                "text": {
                  "text": "Really?",
                  "wikitext": "'''Ellie Chu''': Really?"
                },
                "is_stage_direction": false
              },
              {
                "speaker": "Paul Munsky",
                "text": {
                  "text": "Yeah. I fell asleep a few times, but I'm still reading it. That's gotta count for something.",
                  "wikitext": "'''Paul Munsky''': Yeah. I fell asleep a few times, but I'm still reading it. That's gotta count for something."
                },
                "is_stage_direction": false
              }
            ]
          },
          {
            "block": "rule"
          },
          {
            "block": "exchange",
            "turns": [
              {
                "speaker": "Paul Munsky",
                "text": {
                  "text": "What else could I like about her?",
                  "wikitext": "'''Paul Munsky''': What else could I like about her?"
                },
                "is_stage_direction": false
              }
            ]
          },
          {
            "block": "paragraph",
            "text": "Ellie Chu: I don't know. How her eyes look right into yours. How... she twirls her hair when she's reading. How... her laugh... busts out like she can't help herself and she stops being so perfect for just a few moments.",
            "wikitext": "Ellie Chu: I don't know. How her eyes look right into yours. How... she twirls her hair when she's reading. How... her laugh... busts out like she can't help herself and she stops being so perfect for just a few moments."
          },
          {
            "block": "rule"
          },
          {
            "block": "exchange",
            "turns": [
              {
                "speaker": "Paul Munsky",
                "text": {
                  "text": "Go to the dressing room. I-I'll toss you some things.",
                  "wikitext": "'''Paul Munsky''': Go to the dressing room. I-I'll toss you some things."
                },
                "is_stage_direction": false
              },
              {
                "speaker": "Ellie Chu",
                "text": {
                  "text": "But you're a dude.",
                  "wikitext": "'''Ellie Chu''': But you're a dude."
                },
                "is_stage_direction": false
              },
              {
                "speaker": "Paul Munsky",
                "text": {
                  "text": "I have a sister.",
                  "wikitext": "'''Paul Munsky''': I have a sister."
                },
                "is_stage_direction": false
              }
            ]
          },
          {
            "block": "rule"
          },
          {
            "block": "exchange",
            "turns": [
              {
                "speaker": "Ellie Chu",
                "text": {
                  "text": "Gravity is matter's response to loneliness.",
                  "wikitext": "'''Ellie Chu''': Gravity is matter's response to loneliness."
                },
                "is_stage_direction": false
              }
            ]
          }
        ]
      },
